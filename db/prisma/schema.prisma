// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @db.VarChar(12)
  email        String   @unique
  phoneNumber  String?  @db.VarChar(15)
  name         String?  @db.VarChar(100)
  position     String   @default("user") @db.VarChar(10)
  profilePic   String?  @db.VarChar(500)

  isMember    Boolean  @default(true)
  isActive    Boolean  @default(true)
  isAdmin     Boolean  @default(false)
  isStaff     Boolean  @default(false)
  isSuperuser Boolean  @default(false)

  // Relations
  orders       Order[]
  cartItems    CartItem[]

  @@index([email])
  @@index([position])
}

model Product {
  id                BigInt     @id @default(autoincrement())
  name              String
  price             Decimal    @db.Decimal(10, 2)
  maxQuantity       Int        @default(1)

  isNameRequired    Boolean    @default(false)
  isSizeRequired    Boolean    @default(false)
  isImageRequired   Boolean    @default(false)
  acceptOrders      Boolean    @default(true)
  isVisible         Boolean    @default(true)
  description       String?

  forUserPositions  String[]

  image1            String?    // stored path
  image2            String?
  sizeChartImage    String?

  // Relations
  orderItems        OrderItem[]
  cartItems         CartItem[]

  @@index([acceptOrders])
  @@index([isVisible])
  @@index([name])
}


model DiscountCode {
  id                  BigInt    @id @default(autoincrement())
  code                String    @unique @db.VarChar(20)
  discountPercentage  Decimal   @db.Decimal(5, 2)
  maxUses             Int
  expiryDate          DateTime
  forUserPositions    String[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  custom              Boolean   @default(false)
  uses                Int       @default(0)

  // Relations
  orders              Order[]

  @@index([expiryDate])
  @@index([custom])
}

model Order {
  id              String     @id @db.VarChar(50)
  userId          String?    @db.VarChar(12)
  createdAt       DateTime   @default(now())
  updatedAmount   Decimal    @db.Decimal(10, 2)
  isVerified      Boolean    @default(false)
  mailAdded       Boolean    @default(false)
  totalAmount     Decimal    @default(0.00) @db.Decimal(10, 2)
  qrCodeData      String?
  isCompleted     Boolean    @default(false)

  // Relations
  user            User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  discountCodeId  BigInt?
  discountCode    DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  orderItems      OrderItem[]
  payment         Payment?

  @@index([userId])
  @@index([discountCodeId])
  @@index([isVerified])
  @@index([isCompleted])
}

// Items of an order
model OrderItem {
  id            BigInt   @id @default(autoincrement())
  orderId       String
  productId     BigInt?
  printingName  String?  @db.VarChar(100)
  size          String?  @db.VarChar(5)
  imageUrl      String?  @db.VarChar(5000)
  quantity      Int      @default(1)

  // Relations
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

// One-to-one payment with an order
model Payment {
  id              BigInt    @id @default(autoincrement())
  orderId         String    @unique
  transactionId   String    @unique @db.VarChar(100)
  paidAmount      Decimal   @db.Decimal(10, 2)
  status          String    @db.VarChar(20)
  paymentDate     DateTime  @default(now())
  paymentId       String?   @unique @db.VarChar(100)
  reason          String?

  // Relations
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([paymentDate])
}

model CartItem {
  id                 BigInt    @id @default(autoincrement())
  userId             String
  productId          BigInt
  quantity           Int       @default(1)
  totalAmount        Decimal   @default(0.00) @db.Decimal(10, 2)
  discountPercentage Decimal   @default(0.00) @db.Decimal(5, 2)
  updatedAmount      Decimal   @default(0.00) @db.Decimal(10, 2)
  createdAt          DateTime  @default(now())
  printingName       String?   @db.VarChar(100)
  size               String?   @db.VarChar(5)
  imageUrl           String?   @db.VarChar(5000)

  // Relations
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
}